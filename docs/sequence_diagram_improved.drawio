        </mxCell>
        <mxCell id="s2_3" value="2.3 SELECT counselors, COUNT(daily_bookings) &lt; 9" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="675" relative="1" as="geometry"><mxPoint x="965" y="675" as="targetPoint" /></mxGeometry>
