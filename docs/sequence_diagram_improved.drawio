        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 1: AUTHENTICATION                                       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="sec1_bg" value="" style="rounded=1;fillColor=#e8f4f8;strokeColor=#1a4a6b;strokeWidth=2;opacity=50;" parent="1" vertex="1">
          <mxGeometry x="30" y="175" width="1840" height="370" as="geometry" />
        </mxCell>
        <mxCell id="sec1_label" value="1 — AUTHENTICATION &amp; SESSION MANAGEMENT" style="text;html=1;strokeColor=none;fillColor=#1a4a6b;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="30" y="175" width="450" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1.1: Student → WebApp: Login/Register -->
        <mxCell id="s1_1" value="1.1 Login / Register" style="endArrow=block;endFill=1;strokeColor=#1e3a5f;strokeWidth=2;fontStyle=1;" parent="1" edge="1">
          <mxGeometry x="105" y="225" relative="1" as="geometry"><mxPoint x="305" y="225" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.2: WebApp → Backend API: Forward credentials -->
        <mxCell id="s1_2" value="1.2 POST credentials (email, password)" style="endArrow=block;endFill=1;strokeColor=#155e4a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="305" y="255" relative="1" as="geometry"><mxPoint x="525" y="255" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.3: API → Auth Service: Validate -->
        <mxCell id="s1_3" value="1.3 Validate credentials &amp; role" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="285" relative="1" as="geometry"><mxPoint x="745" y="285" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.4: Auth → DB: Lookup user -->
        <mxCell id="s1_4" value="1.4 SELECT user, password_hash, role" style="endArrow=block;endFill=1;strokeColor=#4a1260;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="745" y="315" relative="1" as="geometry"><mxPoint x="965" y="315" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.5: DB → Auth: User record -->
        <mxCell id="s1_5" value="1.5 Returns user record" style="endArrow=block;endFill=1;dashed=1;strokeColor=#7a1e1e;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="965" y="345" relative="1" as="geometry"><mxPoint x="745" y="345" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.6: Auth → Auth: Verify password + role check -->
        <mxCell id="s1_6" value="1.6 password_verify() + role policy check" style="endArrow=block;endFill=0;strokeColor=#4a1260;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="745" y="375" relative="1" as="geometry"><mxPoint x="835" y="375" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.7: Auth → API: Issue session token -->
        <mxCell id="s1_7" value="1.7 Issue session token + set $_SESSION" style="endArrow=block;endFill=1;dashed=1;strokeColor=#4a1260;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="745" y="405" relative="1" as="geometry"><mxPoint x="525" y="405" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.8: API → WebApp: JSON success + role redirect -->
        <mxCell id="s1_8" value="1.8 JSON { role, redirect: dashboard_[role].html }" style="endArrow=block;endFill=1;dashed=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="435" relative="1" as="geometry"><mxPoint x="305" y="435" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Step 1.9: WebApp → Student: Redirect to dashboard -->
        <mxCell id="s1_9" value="1.9 Redirect to role dashboard" style="endArrow=block;endFill=1;dashed=1;strokeColor=#155e4a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="305" y="465" relative="1" as="geometry"><mxPoint x="105" y="465" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Auth failure note -->
        <mxCell id="s1_fail_note" value="⚠ Auth Failure: HTTP 401/403 → Show error message → Retry" style="text;html=1;strokeColor=#e74c3c;fillColor=#fdecea;align=left;fontSize=11;fontStyle=2;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="105" y="490" width="470" height="22" as="geometry" />
        </mxCell>
        <!-- Counselor pending note -->
        <mxCell id="s1_pend_note" value="⚠ Counselor pending approval: HTTP 403 → 'Account awaiting administrator activation'" style="text;html=1;strokeColor=#e67e22;fillColor=#fef9e7;align=left;fontSize=11;fontStyle=2;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="105" y="517" width="620" height="22" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 2: APPOINTMENT BOOKING                                  -->
