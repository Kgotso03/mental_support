        <mxCell id="sec2_label" value="2 — APPOINTMENT BOOKING &amp; COUNSELOR NOTIFICATION" style="text;html=1;strokeColor=none;fillColor=#155e4a;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="30" y="565" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s2_1" value="2.1 Query counselor availability" style="endArrow=block;endFill=1;strokeColor=#1e3a5f;strokeWidth=2;" parent="1" edge="1">
