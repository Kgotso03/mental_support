        <mxCell id="s2_4" value="2.4 Returns available slots" style="endArrow=block;endFill=1;dashed=1;strokeColor=#7a1e1e;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="965" y="705" relative="1" as="geometry"><mxPoint x="305" y="705" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_5" value="2.5 Display available slots" style="endArrow=block;endFill=1;dashed=1;strokeColor=#155e4a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="305" y="735" relative="1" as="geometry"><mxPoint x="105" y="735" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_6" value="2.6 Select counselor, date &amp; time → Book Appointment" style="endArrow=block;endFill=1;strokeColor=#1e3a5f;strokeWidth=2;fontStyle=1;" parent="1" edge="1">
          <mxGeometry x="105" y="765" relative="1" as="geometry"><mxPoint x="305" y="765" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_7" value="2.7 POST /book_appointment {counselor_id, date, time, session_type}" style="endArrow=block;endFill=1;strokeColor=#155e4a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="305" y="795" relative="1" as="geometry"><mxPoint x="525" y="795" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Validation box -->
        <mxCell id="s2_8_note" value="Validate: working hours 08:30–16:30, no overlap, counselor &lt;9 bookings/day, future date" style="text;html=1;strokeColor=#e67e22;fillColor=#fef9e7;align=left;fontSize=11;fontStyle=2;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="810" width="530" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s2_9" value="2.8 BEGIN TRANSACTION → INSERT appointment (status=pending)" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="842" relative="1" as="geometry"><mxPoint x="965" y="842" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_10" value="2.9 INSERT notification for Counselor → COMMIT" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="872" relative="1" as="geometry"><mxPoint x="1185" y="872" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_11" value="2.10 send_email() → Student: 'Booking pending confirmation'" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="902" relative="1" as="geometry"><mxPoint x="1405" y="902" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_12" value="2.11 send_email() → Counselor: 'New booking request received'" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="932" relative="1" as="geometry"><mxPoint x="1405" y="932" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_13" value="2.12 Emails dispatched via Gmail SMTP (TLS 587)" style="endArrow=block;endFill=1;dashed=1;strokeColor=#1a5c1a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="1405" y="962" relative="1" as="geometry"><mxPoint x="525" y="962" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_14" value="2.13 JSON { success: true } → Show confirmation" style="endArrow=block;endFill=1;dashed=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="992" relative="1" as="geometry"><mxPoint x="105" y="992" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s2_booked_note" value="⚠ Fully booked (≥9): API returns recommended_counselor_id → Student prompted to switch" style="text;html=1;strokeColor=#e74c3c;fillColor=#fdecea;align=left;fontSize=11;fontStyle=2;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="105" y="1010" width="590" height="22" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 3: COUNSELOR DECISION                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="sec3_bg" value="" style="rounded=1;fillColor=#fef9e7;strokeColor=#5c4a00;strokeWidth=2;opacity=50;" parent="1" vertex="1">
          <mxGeometry x="30" y="1055" width="1840" height="360" as="geometry" />
        </mxCell>
        <mxCell id="sec3_label" value="3 — COUNSELOR DECISION: ACCEPT / DECLINE / GROUP RECOMMENDATION" style="text;html=1;strokeColor=none;fillColor=#5c4a00;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="30" y="1055" width="620" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s3_1" value="3.1 Counselor receives new booking notification" style="endArrow=block;endFill=1;dashed=1;strokeColor=#1a4a6b;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="1185" y="1105" relative="1" as="geometry"><mxPoint x="1625" y="1105" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3_2" value="3.2 Reviews booking request on dashboard" style="endArrow=block;endFill=0;strokeColor=#5c4a00;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="1625" y="1135" relative="1" as="geometry"><mxPoint x="1720" y="1135" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Accept path -->
        <mxCell id="s3_accept_note" value="[Option A: ACCEPT]" style="text;html=1;strokeColor=#27ae60;fillColor=#eafaf1;align=left;fontSize=11;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1200" y="1155" width="180" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s3_3" value="3.3 POST /update_appointment { status:'accepted' }" style="endArrow=block;endFill=1;strokeColor=#5c4a00;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="1625" y="1185" relative="1" as="geometry"><mxPoint x="525" y="1185" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3_4" value="3.4 UPDATE appointments SET status='accepted'" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="1215" relative="1" as="geometry"><mxPoint x="965" y="1215" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3_5" value="3.5 INSERT notification + send_email() → Student: 'Appointment Confirmed'" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="1245" relative="1" as="geometry"><mxPoint x="1405" y="1245" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Decline path -->
        <mxCell id="s3_decline_note" value="[Option B: DECLINE]" style="text;html=1;strokeColor=#e74c3c;fillColor=#fdecea;align=left;fontSize=11;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1200" y="1270" width="180" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s3_6" value="3.6 POST /update_appointment { status:'declined' }" style="endArrow=block;endFill=1;strokeColor=#5c4a00;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="1625" y="1300" relative="1" as="geometry"><mxPoint x="525" y="1300" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3_7" value="3.7 UPDATE status='declined' + INSERT notification + send_email() → Student" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="1330" relative="1" as="geometry"><mxPoint x="1405" y="1330" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Group recommendation -->
        <mxCell id="s3_group_note" value="[Option C: COMPLETE + RECOMMEND GROUP DISCUSSION]" style="text;html=1;strokeColor=#8e44ad;fillColor=#f5eaf9;align=left;fontSize=11;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="1355" width="500" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s3_8" value="3.8 POST { status:'completed', recommend_group: true }" style="endArrow=block;endFill=1;strokeColor=#5c4a00;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="1625" y="1385" relative="1" as="geometry"><mxPoint x="525" y="1385" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3_9" value="3.9 UPDATE status='completed' + UPDATE students_profile SET group_recommended=1" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="1395" relative="1" as="geometry"><mxPoint x="965" y="1395" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 4: SESSION JOIN (VIDEO)                                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="sec4_bg" value="" style="rounded=1;fillColor=#fdecea;strokeColor=#5c1a1a;strokeWidth=2;opacity=50;" parent="1" vertex="1">
          <mxGeometry x="30" y="1445" width="1840" height="440" as="geometry" />
        </mxCell>
        <mxCell id="sec4_label" value="4 — VIDEO SESSION: JOIN, LIVE SESSION &amp; SESSION END" style="text;html=1;strokeColor=none;fillColor=#5c1a1a;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="30" y="1445" width="520" height="30" as="geometry" />
        </mxCell>

        <!-- Join -->
