        <!-- SECTION 9: ADMIN — USER MANAGEMENT                             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="sec9_bg" value="" style="rounded=1;fillColor=#fdecea;strokeColor=#7a1e1e;strokeWidth=2;opacity=50;" parent="1" vertex="1">
          <mxGeometry x="30" y="3465" width="1840" height="470" as="geometry" />
        </mxCell>
        <mxCell id="sec9_label" value="9 — ADMIN: COUNSELOR CREATION &amp; USER ACCOUNT DELETION (Audit Logged)" style="text;html=1;strokeColor=none;fillColor=#7a1e1e;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="30" y="3465" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Admin reads data -->
        <mxCell id="s9_admin_note" value="[Admin logs in as role='admin' — auth verified above]" style="text;html=1;strokeColor=none;fillColor=#fdecea;align=left;fontSize=11;fontStyle=2;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="3508" width="430" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s9_1" value="9.1 Admin views pending counselors list" style="endArrow=block;endFill=1;strokeColor=#1e3a5f;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="105" y="3540" relative="1" as="geometry"><mxPoint x="305" y="3540" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_2" value="9.2 GET /admin/manage_users?role=counselor" style="endArrow=block;endFill=1;strokeColor=#155e4a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="305" y="3570" relative="1" as="geometry"><mxPoint x="525" y="3570" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_3" value="9.3 Verify admin session → SELECT users JOIN counselors WHERE role='counselor'" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3600" relative="1" as="geometry"><mxPoint x="965" y="3600" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_4" value="9.4 Returns counselor list (name, specialty, status)" style="endArrow=block;endFill=1;dashed=1;strokeColor=#7a1e1e;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="965" y="3630" relative="1" as="geometry"><mxPoint x="105" y="3630" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Approval flow -->
        <mxCell id="s9_appr_note" value="Part A: Admin Adds Counselor" style="text;html=1;strokeColor=#27ae60;fillColor=#eafaf1;align=left;fontSize=11;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="3655" width="220" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s9_5" value="9.5 Fill form &amp; click 'Add' → POST { action:'add_counselor', email, name, password, specialty, bio }" style="endArrow=block;endFill=1;strokeColor=#155e4a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="305" y="3685" relative="1" as="geometry"><mxPoint x="525" y="3685" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_6" value="9.6 BEGIN TRANSACTION → INSERT user + INSERT counselor (status='active')" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3715" relative="1" as="geometry"><mxPoint x="965" y="3715" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_7" value="9.7 INSERT notification for counselor + COMMIT" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3745" relative="1" as="geometry"><mxPoint x="1185" y="3745" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_8" value="9.8 send_email() → Counselor: Welcome &amp; Login Credentials" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3775" relative="1" as="geometry"><mxPoint x="1405" y="3775" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_9" value="9.9 JSON { success:true, message:'Counselor added successfully!' } → Refresh list" style="endArrow=block;endFill=1;dashed=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3805" relative="1" as="geometry"><mxPoint x="105" y="3805" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Delete flow -->
        <mxCell id="s9_del_note" value="Part B: Delete User (requires admin_password + reason)" style="text;html=1;strokeColor=#e74c3c;fillColor=#fdecea;align=left;fontSize=11;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="3830" width="430" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s9_10" value="9.10 POST { action:'delete_user', user_id, admin_password, reason }" style="endArrow=block;endFill=1;strokeColor=#155e4a;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="305" y="3862" relative="1" as="geometry"><mxPoint x="525" y="3862" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_11_note" value="Verify admin_password → if wrong: HTTP 403 'Access denied'" style="text;html=1;strokeColor=#e74c3c;fillColor=#fdecea;align=left;fontSize=11;fontStyle=2;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="3875" width="460" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s9_12" value="9.11 DELETE FROM users WHERE id=? (CASCADE deletes related records)" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3905" relative="1" as="geometry"><mxPoint x="965" y="3905" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_13" value="9.12 INSERT INTO deletion_logs (table, record_id, deleted_by, reason, deleted_at)" style="endArrow=block;endFill=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3935" relative="1" as="geometry"><mxPoint x="965" y="3935" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s9_14" value="9.13 JSON { success:true, 'User deleted &amp; action logged' } → Refresh dashboard" style="endArrow=block;endFill=1;dashed=1;strokeColor=#5c3317;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="525" y="3965" relative="1" as="geometry"><mxPoint x="105" y="3965" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
